    "test:integration": "tsx --env-file-if-exists=.env.test.local --import ./tests/setup.ts --test tests/*.integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm test && pnpm test:e2e && pnpm test:demo"
